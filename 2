        });
        document.addEventListener('mousemove', (e) => {
            if (isDraggingProgress) seekToPosition(e);
        });
        document.addEventListener('mouseup', () => {
            isDraggingProgress = false;
        });

        progressContainer.addEventListener('touchstart', (e) => {
            isDraggingProgress = true;
            seekToPosition(e);
        }, { passive: true });
        document.addEventListener('touchmove', (e) => {
            if (isDraggingProgress) seekToPosition(e);
        }, { passive: true });
        document.addEventListener('touchend', () => {
            isDraggingProgress = false;
        });

        // 播放进度与时间更新
        playerVideo.addEventListener('timeupdate', () => {
            if (!isDraggingProgress && playerVideo.duration) {
                const percent = (playerVideo.currentTime / playerVideo.duration) * 100;
                updateProgressUI(percent);
            }
            const timeDisplay = playerOverlay.querySelector('#km-time-display');
            if (timeDisplay) {
                timeDisplay.textContent = `${formatTime(playerVideo.currentTime)} / ${formatTime(playerVideo.duration)}`;
            }
        });

        // 缓存进度更新
        playerVideo.addEventListener('progress', () => {
            const bufferBar = playerOverlay.querySelector('#km-buffer-bar');
            if (bufferBar && playerVideo.duration) {
                const b = playerVideo.buffered;
                let bufEnd = 0;
                for (let i = 0; i < b.length; i++) {
                    if (b.start(i) <= playerVideo.currentTime && b.end(i) >= playerVideo.currentTime) {
                        bufEnd = b.end(i);
                        break;
                    }
                }
                bufferBar.style.width = (bufEnd / playerVideo.duration * 100) + '%';
            }
        });

        // 倍速弹出菜单事件绑定
        const speedBtn = playerOverlay.querySelector('#km-speed-btn');
        const speedMenu = playerOverlay.querySelector('#km-speed-menu');
        if (speedBtn && speedMenu) {
            speedBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                playerOverlay.querySelector('#km-quality-menu').classList.remove('show');
                speedMenu.classList.toggle('show');
            });

            speedMenu.querySelectorAll('.km-menu-item').forEach(item => {
                item.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const speed = parseFloat(item.dataset.speed);
                    playerVideo.playbackRate = speed;
                    speedMenu.querySelectorAll('.km-menu-item').forEach(b => b.classList.remove('active'));
                    item.classList.add('active');
                    speedBtn.textContent = speed === 1 ? '倍速' : speed + 'x';
                    speedMenu.classList.remove('show');
                    showSpeedHint(speed + 'x');
                    pmSet('km_speed', speed);
                });
            });
        }

        // 画质切换菜单弹出事件绑定
        const qBtn = playerOverlay.querySelector('#km-quality-btn');
        const qMenu = playerOverlay.querySelector('#km-quality-menu');
        if (qBtn && qMenu) {
            qBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                speedMenu.classList.remove('show');
                qMenu.classList.toggle('show');
            });
        }
        document.addEventListener('click', () => {
            qMenu?.classList.remove('show');
            speedMenu?.classList.remove('show');
        });

        // 音量调节逻辑
        const volumeBtn = playerOverlay.querySelector('#km-volume-btn');
        const volumeSlider = playerOverlay.querySelector('#km-volume-slider');
        let lastVolume = parseFloat(pmGet('km_volume', 1)) || 1;
        playerVideo.volume = lastVolume;
        volumeSlider.value = lastVolume;

        const updateVolumeUI = (vol) => {
            volumeSlider.value = vol;
            if (vol === 0) {
                volumeBtn.textContent = '🔇';
            } else if (vol < 0.5) {
                volumeBtn.textContent = '🔉';
            } else {
                volumeBtn.textContent = '🔊';
            }
        };
        updateVolumeUI(lastVolume);

        volumeSlider.addEventListener('input', (e) => {
            e.stopPropagation();
            const vol = parseFloat(volumeSlider.value);
            playerVideo.volume = vol;
            lastVolume = vol;
            pmSet('km_volume', vol);
            updateVolumeUI(vol);
        });
        volumeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (playerVideo.volume > 0) {
                playerVideo.volume = 0;
                updateVolumeUI(0);
            } else {
                playerVideo.volume = lastVolume || 1;
                updateVolumeUI(lastVolume || 1);
            }
        });

        // 画中画按钮
        playerOverlay.querySelector('#km-pip-btn').addEventListener('click', async (e) => {
            e.stopPropagation();
            try {
                if (document.pictureInPictureElement) {
                    await document.exitPictureInPicture();
                } else if (playerVideo.requestPictureInPicture) {
                    await playerVideo.requestPictureInPicture();
                } else {
                    showToast('浏览器不支持画中画');
                }
            } catch (err) {
                showToast('画中画启动失败');
            }
        });

        // 全屏按钮
        playerOverlay.querySelector('#km-fullscreen-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            toggleFullscreen();
        });

        // 上一个/下一个
        playerOverlay.querySelector('#km-prev-btn').addEventListener('click', (e) => { e.stopPropagation(); navigatePlaylist(-1); });
        playerOverlay.querySelector('#km-next-btn').addEventListener('click', (e) => { e.stopPropagation(); navigatePlaylist(1); });

        // 阻止右键菜单
        playerVideo.addEventListener('contextmenu', (e) => { e.preventDefault(); });

        // 移动端手势控制
        let longPressTimer = null;
        let wasSpeed = 1;
        let isLongPressing = false;
        let touchStartX = 0;
        let touchStartY = 0;
        let videoStartTime = 0;
        let videoStartVol = 0;
        let hasMoved = false;
        let swipeDirection = null;
        let gestureTargetTime = null;

        playerVideo.addEventListener('touchstart', (e) => {
            if (e.touches.length !== 1) return;
            const touch = e.touches[0];
            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
            videoStartTime = playerVideo.currentTime;
            videoStartVol = playerVideo.volume;
            hasMoved = false;
            swipeDirection = null;
            gestureTargetTime = null;
            isLongPressing = false;

            longPressTimer = setTimeout(() => {
                if (hasMoved) return;
                isLongPressing = true;
                wasSpeed = playerVideo.playbackRate;
                playerVideo.playbackRate = 2;
                showSpeedHint('▶▶ 2x 长按加速中');
            }, 500);
        }, { passive: true });

        playerVideo.addEventListener('touchmove', (e) => {
            if (e.touches.length !== 1) return;
            const touch = e.touches[0];
            const dx = touch.clientX - touchStartX;
            const dy = touch.clientY - touchStartY;

            if (!hasMoved && (Math.abs(dx) > 10 || Math.abs(dy) > 10)) {
                hasMoved = true;
                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }
            }

            if (isLongPressing) return;

            if (hasMoved && !swipeDirection) {
                if (Math.abs(dx) > Math.abs(dy)) swipeDirection = 'horizontal';
                else swipeDirection = 'vertical';
            }

            if (swipeDirection === 'horizontal') {
                if (e.cancelable) e.preventDefault();
                const seekRatio = dx / playerVideo.clientWidth;
                const totalDuration = playerVideo.duration || 0;
                if (totalDuration > 0) {
                    gestureTargetTime = Math.max(0, Math.min(totalDuration, videoStartTime + seekRatio * 180));
                    showSpeedHint(`进度: ${formatTime(gestureTargetTime)} / ${formatTime(totalDuration)}`);
                    const percent = (gestureTargetTime / totalDuration) * 100;
                    updateProgressUI(percent);
                }
            } else if (swipeDirection === 'vertical') {
                if (e.cancelable) e.preventDefault();
                const rect = playerVideo.getBoundingClientRect();
                const isRightSide = touchStartX > (rect.left + rect.width / 2);
                if (isRightSide) {
                    const volDelta = -dy / playerVideo.clientHeight;
                    const targetVol = Math.max(0, Math.min(1, videoStartVol + volDelta));
                    playerVideo.volume = targetVol;
                    updateVolumeUI(targetVol);
                    showSpeedHint(`音量: ${Math.round(targetVol * 100)}%`);
                }
            }
        }, { passive: false });

        const releaseGesture = () => {
            if (longPressTimer) {
                clearTimeout(longPressTimer);
                longPressTimer = null;
            }
            if (isLongPressing) {
                playerVideo.playbackRate = wasSpeed;
                hideSpeedHint();
                isLongPressing = false;
            }
            if (swipeDirection === 'horizontal' && gestureTargetTime !== null) {
                playerVideo.currentTime = gestureTargetTime;
                hideSpeedHint();
                gestureTargetTime = null;
            } else if (swipeDirection === 'vertical') {
                hideSpeedHint();
            }
            swipeDirection = null;
            hasMoved = false;
        };

        playerVideo.addEventListener('touchend', releaseGesture, { passive: true });
        playerVideo.addEventListener('touchcancel', releaseGesture, { passive: true });

        // 双击全屏
        playerVideo.addEventListener('dblclick', (e) => {
            e.preventDefault();
            toggleFullscreen();
        });

        // 缓冲/加载状态 spinner 切换
        playerVideo.addEventListener('waiting', showSpinner);
        playerVideo.addEventListener('seeking', showSpinner);
        playerVideo.addEventListener('playing', hideSpinner);
        playerVideo.addEventListener('canplay', hideSpinner);
        playerVideo.addEventListener('seeked', hideSpinner);

        // 手动重新加载按钮
        const reloadBtn = playerOverlay.querySelector('#km-reload-btn');
        if (reloadBtn) {
            reloadBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (currentPlayUrl) {
                    playM3u8Inline(currentPlayUrl, currentPlayUrl);
                }
            });
        }
    }

    function showSpinner() {
        const spinner = playerOverlay?.querySelector('#km-spinner');
        if (spinner) spinner.style.display = 'block';
    }

    function hideSpinner() {
        const spinner = playerOverlay?.querySelector('#km-spinner');
        if (spinner) spinner.style.display = 'none';
    }

    function showSpeedHint(text) {
        const display = playerOverlay?.querySelector('#km-speed-display');
        if (!display) return;
        display.textContent = text;
        display.classList.add('visible');
        clearTimeout(display._hideTimer);
        display._hideTimer = setTimeout(() => display.classList.remove('visible'), 800);
    }

    function hideSpeedHint() {
        const display = playerOverlay?.querySelector('#km-speed-display');
        if (display) display.classList.remove('visible');
    }

    function toggleFullscreen() {
        const container = playerOverlay?.querySelector('#km-player-container');
        if (!container) return;
        if (document.fullscreenElement) {
            document.exitFullscreen().catch(() => {});
        } else {
            (container.requestFullscreen || container.webkitRequestFullscreen || container.msRequestFullscreen)?.call(container);
        }
    }

    function navigatePlaylist(direction) {
        const total = capturedUrls.length;
        if (total === 0) return;
        let target = currentPlayIndex + direction;
        if (target >= 0 && target < total) {
            playM3u8Inline(capturedUrls[target].url, capturedUrls[target].title);
        }
    }

    function updatePlayerNav() {
        if (!playerOverlay) return;
        const total = capturedUrls.length;
        const infoEl = playerOverlay.querySelector('#km-player-info');
        if (infoEl) {
            infoEl.textContent = total > 0 ? `播放 ${currentPlayIndex + 1}/${total}` : '';
            infoEl.style.opacity = total > 0 ? '1' : '0';
        }
        const prevBtn = playerOverlay.querySelector('#km-prev-btn');
        const nextBtn = playerOverlay.querySelector('#km-next-btn');
        if (prevBtn) prevBtn.disabled = (currentPlayIndex <= 0);
        if (nextBtn) nextBtn.disabled = (currentPlayIndex >= total - 1 || currentPlayIndex === -1);
    }

    function setupQualitySelector() {
        if (!playerOverlay || !hlsInstance) return;
        const qBtn = playerOverlay.querySelector('#km-quality-btn');
        const qMenu = playerOverlay.querySelector('#km-quality-menu');
        if (!qBtn || !qMenu) return;

        try {
            const levels = hlsInstance.levels || [];
            if (levels.length <= 1) {
                qBtn.style.display = 'none';
                return;
            }
            qBtn.style.display = 'flex';
            qMenu.innerHTML = '';

            const autoItem = document.createElement('button');
            autoItem.className = 'km-menu-item';
            autoItem.textContent = '自动';
            autoItem.dataset.level = '-1';
            if (hlsInstance.loadLevel === -1) autoItem.classList.add('active');
            qMenu.appendChild(autoItem);

            levels.forEach((level, index) => {
                const item = document.createElement('button');
                item.className = 'km-menu-item';
                const height = level.height ? `${level.height}P` : `${index + 1}档`;
                item.textContent = height;
                item.dataset.level = String(index);
                if (hlsInstance.loadLevel === index) item.classList.add('active');
                qMenu.appendChild(item);
            });

            qMenu.querySelectorAll('.km-menu-item').forEach(item => {
                item.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const levelIdx = parseInt(item.dataset.level, 10);
                    hlsInstance.currentLevel = levelIdx;
                    qMenu.querySelectorAll('.km-menu-item').forEach(b => b.classList.remove('active'));
                    item.classList.add('active');
                    qBtn.textContent = item.textContent;
                    qMenu.classList.remove('show');
                    pmSet('km_quality_level', levelIdx);
                });
            });

            const curLevel = hlsInstance.currentLevel;
            const activeBtn = qMenu.querySelector(`[data-level="${curLevel}"]`);
            if (activeBtn) qBtn.textContent = activeBtn.textContent;
        } catch(e) {}
    }

    function playM3u8Inline(url, title) {
        destroyPlayer(true);
        createPlayerOverlay();

        // 压入虚拟历史记录，用于拦截物理返回/后退键
        try {
            window.history.pushState({ kmPlayer: true }, '', window.location.href);
        } catch (e) {}

        // 自动暂停/静音页面上其他的 video 元素
        document.querySelectorAll('video').forEach(v => {
            if (v.id !== 'km-player-video') {
                v.muted = true;
                try { v.pause(); } catch(e) {}
            }
        });

        const idx = capturedUrls.findIndex(item => item.url === url);
        if (idx !== -1) currentPlayIndex = idx;
        currentPlayUrl = url;

        if (hlsInstance) {
            try { hlsInstance.destroy(); } catch (e) {}
            hlsInstance = null;
        }
        playerVideo.removeAttribute('src');

        const savedSpeed = parseFloat(pmGet('km_speed', 1)) || 1;
        playerVideo.playbackRate = savedSpeed;
        playerOverlay.querySelectorAll('#km-speed-menu [data-speed]').forEach(b => {
            b.classList.toggle('active', parseFloat(b.dataset.speed) === savedSpeed);
        });
        const speedBtn = playerOverlay.querySelector('#km-speed-btn');
        if (speedBtn) speedBtn.textContent = savedSpeed === 1 ? '倍速' : savedSpeed + 'x';

        playerVideo.muted = false;
        playerVideo.volume = parseFloat(pmGet('km_volume', 1)) || 1;

        if (typeof Hls !== 'undefined' && Hls.isSupported()) {
            try {
                hlsInstance = new Hls({
                    maxBufferLength: 35,
                    maxMaxBufferLength: 150,
                    maxBufferSize: 80 * 1024 * 1024,
                    backBufferLength: 90
                });
                hlsInstance.on(Hls.Events.MANIFEST_PARSED, () => {
                    setupQualitySelector();
                    const savedLevel = parseInt(pmGet('km_quality_level', -1), 10);
                    hlsInstance.currentLevel = savedLevel;
                    playerVideo.play().catch(() => {});
                });
                hlsInstance.loadSource(url);
                hlsInstance.attachMedia(playerVideo);
            } catch (e) {
                console.warn('[快猫提取] HLS 初始化失败:', e);
                showToast('播放器初始化失败');
                return;
            }
        } else if (playerVideo.canPlayType('application/vnd.apple.mpegurl')) {
            playerVideo.src = url;
            playerVideo.addEventListener('loadedmetadata', () => {
                playerVideo.play().catch(() => {});
            }, { once: true });
        } else {
            showToast('浏览器不支持 HLS 播放');
            return;
        }

        playerOverlay.classList.add('visible');
        const container = playerOverlay.querySelector('.km-player-container');
        if (container) {
            setTimeout(() => { container.classList.add('show'); }, 50);
        }
        updatePlayerNav();
        showToast('▶ 正在加载视频...');
    }

    function destroyPlayer(sync = false) {
        if (hlsInstance) {
            try { hlsInstance.destroy(); } catch (e) {}
            hlsInstance = null;
        }

        // 如果是手动关闭（点击关闭按钮/ESC键），主动回退一步以消费刚才压入的历史记录
        if (!sync) {
            try {
                if (window.history.state && window.history.state.kmPlayer) {
                    window.history.back();
                }
            } catch (e) {}
        }
        const overlay = document.getElementById("km-player-overlay");
        if (overlay) {
            if (sync) {
                overlay.remove();
                playerOverlay = null;
                playerVideo = null;
            } else {
                const container = overlay.querySelector('.km-player-container');
                if (container) container.classList.remove('show');
                overlay.style.opacity = '0';
                setTimeout(() => { overlay.remove(); playerOverlay = null; playerVideo = null; }, 300);
            }
        }
    }

