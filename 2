    // ========== 辅助识别视频链接与封面 ==========

    function isVideoPlayLink(href) {
        if (!href) return false;
        if (href.includes('user_details') || href.includes('video_list') || href.includes('paginate') || href.includes('index') || href.includes('search')) return false;
        if (href.includes('play') || href.includes('details') || href.includes('video') || href.includes('id=')) return true;
        return false;
    }

    function findVideoInfoFromElement(el) {
        if (!el) return null;
        if (el.nodeType !== 1) el = el.parentElement;
        if (!el) return null;
        const link = el.closest('a');
        if (link) { const href = link.getAttribute('href'); if (isVideoPlayLink(href)) {} }

        let searchContainer = null;
        let coverUrl = '';
        let current = el;
        for (let i = 0; i < 6; i++) {
            if (!current || current === document.body || current === document.documentElement) break;
            const tagName = current.tagName.toLowerCase();
            const className = current.className || '';
            const isCardClass = typeof className === 'string' && (className.includes('card') || className.includes('item') || className.includes('video') || className.includes('box') || className.includes('list'));
            if (tagName === 'a' || tagName === 'li' || isCardClass) {
                searchContainer = current;
                coverUrl = getValidCoverImage(searchContainer);
                if (coverUrl) break;
            }
            current = current.parentNode;
        }
        if (!searchContainer) searchContainer = link || el.parentNode || el;
        if (!coverUrl) coverUrl = getValidCoverImage(searchContainer);
        let title = '';
        const titleEl = searchContainer.querySelector('.title, .name, .video-title, p, h3, h4');
        if (titleEl) title = titleEl.textContent.trim();
        else title = searchContainer.textContent.trim().substring(0, 40);

        if (coverUrl) {
            if (!coverUrl.startsWith('http')) coverUrl = new URL(coverUrl, window.location.origin).href;
            return { coverUrl, title: title || '快猫视频' };
        }
        return null;
    }

    function getValidCoverImage(container) {
        if (!container) return '';
        const imgs = container.querySelectorAll('img');
        for (const img of imgs) {
            const src = img.getAttribute('src') || img.getAttribute('data-src') || img.getAttribute('data-original');
            if (src && !src.startsWith('data:') && !src.includes('avatar') && !src.includes('logo') && !src.includes('icon')) {
                if (src.match(VIDEO_HASH_RE) || src.includes('cover') || src.includes('uploads')) return src;
            }
        }
        const styledElements = container.querySelectorAll('[style*="background"]');
        for (const item of styledElements) {
            const bg = item.style.backgroundImage;
            if (bg && bg !== 'none' && bg.startsWith('url')) {
                const match = bg.match(/url\(["']?(.*?)["']?\)/);
                if (match && match[1]) {
                    const url = match[1];
                    if (!url.includes('avatar') && !url.includes('logo') && !url.includes('icon') && !url.startsWith('data:')) {
                        if (url.match(VIDEO_HASH_RE) || url.includes('cover') || url.includes('uploads')) return url;
                    }
                }
            }
        }
        try {
            const bg = window.getComputedStyle(container).backgroundImage;
            if (bg && bg !== 'none' && bg.startsWith('url')) {
                const match = bg.match(/url\(["']?(.*?)["']?\)/);
                if (match && match[1]) {
                    const url = match[1];
                    if (!url.includes('avatar') && !url.includes('logo') && !url.includes('icon') && !url.startsWith('data:')) {
                        if (url.match(VIDEO_HASH_RE) || url.includes('cover') || url.includes('uploads')) return url;
                    }
                }
            }
        } catch(e) {}
        return '';
    }

    // ========== History API 劫持 ==========

    function hookHistoryAPI() {
        if (historyHookInstalled) return;
        historyHookInstalled = true;
        const win = WIN;
        const origPushState = win.history.pushState;
        const origReplaceState = win.history.replaceState;
        win.history.pushState = function(...args) { origPushState.apply(this, args); setTimeout(handleRouteChanged, 50); };
        win.history.replaceState = function(...args) { origReplaceState.apply(this, args); setTimeout(handleRouteChanged, 50); };
        win.addEventListener('popstate', () => { setTimeout(handleRouteChanged, 50); });
    }

    // ========== UI 面板 ==========

    function createUI() {
        if (document.getElementById('km-float-btn')) return;

        floatBtn = document.createElement('div');
        floatBtn.id = 'km-float-btn';
        floatBtn.innerHTML = '🐱';
        document.body.appendChild(floatBtn);

        let activeDragging = false, isDragging = false, startX, startY, initialX, initialY;
        floatBtn.addEventListener('mousedown', dragStart);
        document.addEventListener('mousemove', drag);
        document.addEventListener('mouseup', dragEnd);
        floatBtn.addEventListener('touchstart', dragStart, { passive: true });
        document.addEventListener('touchmove', drag, { passive: true });
        document.addEventListener('touchend', dragEnd);

        function dragStart(e) {
            activeDragging = true;
            if (e.type === 'touchstart') { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }
            else { startX = e.clientX; startY = e.clientY; }
            const rect = floatBtn.getBoundingClientRect(); initialX = rect.left; initialY = rect.top; isDragging = false;
        }
        function drag(e) {
            if (!activeDragging) return;
            let clientX, clientY;
            if (e.type === 'touchmove') { clientX = e.touches[0].clientX; clientY = e.touches[0].clientY; }
            else { clientX = e.clientX; clientY = e.clientY; }
            const dx = clientX - startX, dy = clientY - startY;
            if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                isDragging = true;
                const maxX = window.innerWidth - floatBtn.offsetWidth - 10;
                const maxY = window.innerHeight - floatBtn.offsetHeight - 10;
                floatBtn.style.left = `${Math.max(10, Math.min(initialX + dx, maxX))}px`;
                floatBtn.style.top = `${Math.max(10, Math.min(initialY + dy, maxY))}px`;
                floatBtn.style.right = 'auto'; floatBtn.style.bottom = 'auto';
            }
        }
        function dragEnd() { if (!activeDragging) return; activeDragging = false; if (isDragging) setTimeout(() => { isDragging = false; }, 50); }

        floatBtn.addEventListener('click', () => { if (!isDragging) panel.classList.toggle('visible'); });

        panel = document.createElement('div');
        panel.id = 'km-panel';
        panel.innerHTML = `<div id="km-panel-header"><h3>快猫视频提取面板</h3><button id="km-panel-close">&times;</button></div><div id="km-panel-body"><div class="km-empty">⏳ 暂无视频被捕获，正在监测中...</div></div>`;
        document.body.appendChild(panel);

        panel.querySelector('#km-panel-close').addEventListener('click', () => panel.classList.remove('visible'));
        panel.querySelector('#km-panel-body').addEventListener('click', (e) => {
            const actionBtn = e.target.closest('.km-action-btn');
            if (!actionBtn) return;
            e.stopPropagation();
            const item = capturedUrls[Number(actionBtn.dataset.index)];
            if (!item) return;
            if (actionBtn.classList.contains('km-play-btn')) {
                playM3u8Inline(item.url, item.title);
            } else if (actionBtn.classList.contains('km-copy-btn')) {
                try { GM_setClipboard(item.url, 'text'); showToast('✅ 复制成功'); }
                catch (err) { navigator.clipboard.writeText(item.url).then(() => showToast('✅ 复制成功')).catch(() => showToast('❌ 复制失败')); }
            }
        });

        document.addEventListener('click', (e) => {
            if (panel && panel.classList.contains('visible') && !panel.contains(e.target) && !floatBtn.contains(e.target)) panel.classList.remove('visible');
        });

        toastEl = document.createElement('div');
        toastEl.id = 'km-toast';
        document.body.appendChild(toastEl);
    }

    function showToast(msg) {
        if (!toastEl) return;
        if (toastTimer) clearTimeout(toastTimer);
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2500);
    }

