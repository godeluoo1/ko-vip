    function installAjaxHook() {
        try {
            // Hook Fetch
            if (window.fetch) {
                const originalFetch = window.fetch;
                window.fetch = async function(...args) {
                    const response = await originalFetch.apply(this, args);
                    const contentType = response.headers.get('content-type') || '';
                    const url = response.url;

                    // 如果是 API 请求并且返回的是 text/plain 加密流，我们进行深度劫持和篡改重加密
                    if (url.includes('/api/') && (contentType.includes('text/plain') || contentType.includes('text/html'))) {
                        try {
                            const rawText = await response.text();
                            const modifiedText = modifyAndReEncryptResponse(rawText);
                            const modifiedResponse = new Response(modifiedText, {
                                status: response.status,
                                statusText: response.statusText,
                                headers: response.headers
                            });
                            Object.defineProperty(modifiedResponse, 'url', { value: response.url });

                            // 顺便让捕获器记录一下
                            const decrypted = smartDecrypt(rawText);
                            if (decrypted && decrypted.data && decrypted.data.vodPlayUrl) {
                                processCapturedUrl(decrypted.data.vodPlayUrl, 'Fetch Hook (API)');
                            }

                            return modifiedResponse;
                        } catch (e) {
                            console.error('[快猫劫持] Fetch 响应篡改失败:', e);
                        }
                    }

                    const clone = response.clone();
                    try {
                        if (url.includes('.m3u8') || url.includes('.ts')) {
                            processCapturedUrl(url, 'Fetch Hook');
                        } else {
                            const text = await clone.text();
                            if (text.includes('.m3u8')) {
                                const match = text.match(/"([^"]+\.m3u8[^"]*)"/);
                                if (match) processCapturedUrl(match[1], 'Fetch Hook');
                            }
                        }
                    } catch (e) {}

                    if (url && url.includes('/vod/')) {
                        try {
                            capturedImageDomain = new URL(url).origin;
                        } catch(e) {}
                    }

                    return response;
                };
            }

            // Hook XMLHttpRequest
            const originalOpen = XMLHttpRequest.prototype.open;
            XMLHttpRequest.prototype.open = function(method, url, ...args) {
                this._url = url;
                if (url && url.includes('/vod/')) {
                    try {
                        capturedImageDomain = new URL(url, window.location.origin).origin;
                    } catch(e) {}
                }
                return originalOpen.apply(this, [method, url, ...args]);
            };

            const originalSend = XMLHttpRequest.prototype.send;
            XMLHttpRequest.prototype.send = function(...args) {
                // 劫持 responseText / response 属性
                const self = this;

                // 在 readystatechange 时进行拦截和内容篡改
                self.addEventListener('readystatechange', () => {
                    if (self.readyState === 4) {
                        try {
                            const url = self._url || self.responseURL || '';
                            const contentType = self.getResponseHeader('content-type') || '';

                            // 如果是 API 获取视频信息的请求且返回加密文本
                            if (url.includes('/api/') && (contentType.includes('text/plain') || contentType.includes('text/html'))) {
                                const rawResponseText = self.responseText;
                                if (rawResponseText) {
                                    const hackedResponseText = modifyAndReEncryptResponse(rawResponseText);

                                    // 覆盖 responseText 属性以欺骗前端 Vue / Axios
                                    Object.defineProperty(self, 'responseText', {
                                        get: function() { return hackedResponseText; },
                                        configurable: true
                                    });
                                    Object.defineProperty(self, 'response', {
                                        get: function() { return hackedResponseText; },
                                        configurable: true
                                    });

                                    // 解密供本地提取面板备份
                                    const decrypted = smartDecrypt(rawResponseText);
                                    if (decrypted && decrypted.data && decrypted.data.vodPlayUrl) {
                                        processCapturedUrl(decrypted.data.vodPlayUrl, 'XHR Hook (API)');
                                    }
                                }
                            }

                            // 正常的 URL 捕获通道
                            if (url && (url.includes('.m3u8') || url.includes('.ts'))) {
                                processCapturedUrl(url, 'XHR Hook');
                            } else if (self.responseText && self.responseText.includes('.m3u8')) {
                                const match = self.responseText.match(/"([^"]+\.m3u8[^"]*)"/);
                                if (match) processCapturedUrl(match[1], 'XHR Hook');
                            }
                        } catch (e) {
                            console.error('[快猫劫持] XHR 响应拦截篡改失败:', e);
                        }
                    }
                });
                return originalSend.apply(this, args);
            };
            console.log('[快猫提取] XHR / Fetch Hook 深度劫持与重组加密通道已启动');
        } catch (e) {
