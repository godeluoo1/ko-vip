(function () {
    'use strict';

    // ========== 安卓原生 WebView 环境 Polyfill 兼容垫片 ==========
    if (typeof GM_addStyle === 'undefined') {
        const gm_addstyle_impl = function (css) {
            try {
                const style = document.createElement('style');
                style.type = 'text/css';
                style.innerHTML = css;
                (document.head || document.documentElement || document.body).appendChild(style);
            } catch (e) {
                console.error('[快猫劫持-Polyfill] GM_addStyle 失败:', e);
            }
        };
        window.GM_addStyle = gm_addstyle_impl;
        var GM_addStyle = gm_addstyle_impl;
    }
    if (typeof GM_setClipboard === 'undefined') {
        const gm_setclipboard_impl = function (text) {
            try {
                const input = document.createElement('textarea');
                input.value = text;
                (document.body || document.documentElement).appendChild(input);
                input.select();
                document.execCommand('copy');
                (document.body || document.documentElement).removeChild(input);
            } catch (e) {
                console.error('[快猫劫持-Polyfill] GM_setClipboard 失败:', e);
            }
        };
        window.GM_setClipboard = gm_setclipboard_impl;
        var GM_setClipboard = gm_setclipboard_impl;
    }
    if (typeof unsafeWindow === 'undefined') {
        window.unsafeWindow = window;
        var unsafeWindow = window;
    }
    console.log('[快猫劫持] 安卓原生 WebView 兼容垫片加载完成！');

    // ========== 监听返回/后退键以关闭自定义播放器 (防止物理返回键直接退回首页) ==========
    window.addEventListener('popstate', (event) => {
        const overlay = document.getElementById("km-player-overlay");
        if (overlay) {
            destroyPlayer(true);
        }
    });

    // ========== 跨容器同步已解密的封面示例图 (解决加密 .dat 不显示问题) ==========
    function syncImages() {
        try {
            // 1. 搜索页图片同步
            const searchBypass = document.getElementById("km-search-bypass");
            if (searchBypass) {
                const nativeCols = document.querySelectorAll('.search-result-content .movie-col');
                const myCards = searchBypass.querySelectorAll('.km-card');
                nativeCols.forEach((col, index) => {
                    const img = col.querySelector('.nut-img');
                    if (img && img.src && (img.src.startsWith('data:') || img.src.startsWith('blob:') || img.src.includes('/vod/')) && myCards[index]) {
                        const coverEl = myCards[index].querySelector('.km-cover');
                        if (coverEl && !coverEl.style.backgroundImage.includes(img.src)) {
                            coverEl.style.backgroundImage = `url("${img.src}")`;
                        }

                        // 动态提取原网页的图片 CDN 域名
                        if (img.src.startsWith('http') && img.src.includes('/vod/')) {
                            try {
                                capturedImageDomain = new URL(img.src).origin;
                            } catch(e) {}
                        }
                    }
                });
            }

            // 2. 分类列表页/博主详情页图片同步
            const listWrapper = document.querySelector('.km-wrapper');
            if (listWrapper && !searchBypass) {
                const nativeImgs = document.querySelectorAll('#app > div.videolist > div.box img.nut-img, div[class*="list"] div[class*="box"] img.nut-img, #app > div.details img.nut-img, .details img.nut-img');
                const myCards = listWrapper.querySelectorAll('.km-card');
                nativeImgs.forEach((img, index) => {
                    if (img && img.src && (img.src.startsWith('data:') || img.src.startsWith('blob:') || img.src.includes('/vod/')) && myCards[index]) {
                        const coverEl = myCards[index].querySelector('.km-cover');
                        if (coverEl && !coverEl.style.backgroundImage.includes(img.src)) {
                            coverEl.style.backgroundImage = `url("${img.src}")`;
                        }

                        // 动态提取原网页的图片 CDN 域名
                        if (img.src.startsWith('http') && img.src.includes('/vod/')) {
                            try {
                                capturedImageDomain = new URL(img.src).origin;
                            } catch(e) {}
                        }
                    }
                });
            }
        } catch (e) {}
    }

    // requestAnimationFrame 节流同步（减少 CPU 密集遍历，防平板悬浮窗卡顿 ANR）
    let syncTimer = null;
    function throttledSyncImages() {
        if (syncTimer) return;
        syncTimer = requestAnimationFrame(() => {
            syncImages();
            syncTimer = null;
        });
    }

    // 450ms 轮询保底
    setInterval(throttledSyncImages, 450);

    // MutationObserver 0ms 帧同步响应图片渲染
    try {
        const imgObserver = new MutationObserver(throttledSyncImages);
        imgObserver.observe(document.documentElement, {
            subtree: true,
            childList: true,
            attributes: true,
            attributeFilter: ['src']
        });
    } catch(e) {}

    // ========== 自动静音网页原版试看/预览视频 ==========
    setInterval(() => {
        try {
            document.querySelectorAll('video').forEach(v => {
                if (v.id !== 'km-player-video' && v.id !== 'km-embedded-video' && !v.muted) {
                    v.muted = true;
                    v.setAttribute('muted', 'muted');
                }
            });
        } catch (e) {}
    }, 300);

    const WIN = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

    // ========== 全局配置与状态 ==========
    const SETTINGS = {
        apiAddr: "",
        m3u8Prefix: "https://oafjdskpqwjnizlqwenmaqwkcxzpty.keyms2r.xyz/",
        perPage: 18,
        themeColor: "linear-gradient(135deg, #ff9f0a 0%, #ff3b30 100%)",
        themeShadow: "0 4px 15px rgba(255, 159, 10, 0.4)"
    };

    let capturedUrls = [];
    const capturedUrlMap = new Map();
    let uiUpdateQueued = false;
    let uiUpdateTimer = null;
    let routeMutationObserver = null;
    let routeDebounceTimer = null;
    let pageIndex = 1;
    let mediaType = 1;
    let currentHash = '';
    let hooksInstalled = false;
    let historyHookInstalled = false;
    let stylesInjected = false;
    let toastTimer = null;
    const routeTimers = new Set();

    // 搜索与无限滚动状态变量
    let currentKeyword = '';
    let isLoadingPage = false;
    let capturedImageDomain = '';

    // 支持的捕获通道列表
    const CHANNEL_NAMES = [
        'Performance API',
        'Performance Polling',
        'Video Tag Hook',
        'Source Tag Hook',
        'Hls.js Hook',
        'XHR Hook',
        'Fetch Hook',
        'Aliplayer Hook'
    ];

    const channelStats = Object.fromEntries(CHANNEL_NAMES.map(name => [name, {
        seen: 0,
        accepted: 0,
        filtered: 0,
        lastUrl: '',
        lastAcceptedUrl: '',
        lastReason: '尚未触发'
    }]));

    let capturedApiDomain = (() => { try { return localStorage.getItem('km_captured_api_domain') || ''; } catch (e) { return ''; } })();
    let capturedVideoCdn = (() => { try { return localStorage.getItem('km_captured_video_cdn') || ''; } catch (e) { return ''; } })();
    let currentActiveVideoId = '';

    const mediaTypes = {
        "0": 11, "原创视频": 11,
        "1": 3, "热门视频": 3,
        "2": 1, "精选视频": 1,
        "3": 9, "付费视频": 9,
        "4": 2, "视频广场": 2
    };

    // ========== AES 加解密 & 签名核心 ==========
    const KEY = CryptoJS.enc.Utf8.parse("x;j/6olSp})&{ZJD");
    const IV = CryptoJS.enc.Utf8.parse("znbV%$JN5olCpt<c");
    const MODE = CryptoJS.mode.CBC;
    const PADDING = CryptoJS.pad.Pkcs7;
    const VIDEO_HASH_RE = /\/([a-f0-9]{32})(?:\/|\_|\.)/i;
    const PREVIEW_MARK_RE = /_preview(?:\.mp4)?|_preview|_wm\.mp4|_wm/g;

    // ========== 立即执行的核心拦截挂载（抢占全局变量，防止网站JS启动后缓存本地拷贝） ==========
    let coreHooksInstalled = false;
    function installCoreHooks() {
        if (coreHooksInstalled) return;
        coreHooksInstalled = true;

        // 暴露核心方法给页面物理上下文，使其突破沙箱隔离进行调用
        WIN.playM3u8Inline = playM3u8Inline;
        WIN.modifyAndReEncryptResponse = modifyAndReEncryptResponse;
        WIN.processCapturedUrl = processCapturedUrl;
        WIN.smartDecrypt = smartDecrypt;

        // 注入包含 Hls, Aliplayer, fetch, XHR 拦截以及计时器秒杀的脚本到页面上下文
        try {
            const script = document.createElement('script');
            script.textContent = `(${injectPageHooks.toString()})();`;
            (document.head || document.documentElement).appendChild(script);
            script.remove();
            console.log('[快猫劫持] 成功突破沙箱将所有核心拦截钩子注入至网页物理上下文！');
        } catch (e) {
            console.error('[快猫劫持] 注入网页物理上下文钩子失败:', e);
        }
    }
    installCoreHooks();

    // ========== 工具函数 ==========

    function scheduleUIUpdate() {
        if (uiUpdateQueued) return;
        uiUpdateQueued = true;
        if (uiUpdateTimer) clearTimeout(uiUpdateTimer);
        uiUpdateTimer = setTimeout(() => {
            requestAnimationFrame(() => {
                uiUpdateQueued = false;
                updateUI();
            });
        }, 100);
    }

    function resetCapturedUrls() {
        capturedUrls = [];
        capturedUrlMap.clear();
        scheduleUIUpdate();
    }

    function ensureChannelStats(source) {
        if (!channelStats[source]) {
            channelStats[source] = {
                seen: 0, accepted: 0, filtered: 0,
                lastUrl: '', lastAcceptedUrl: '', lastReason: '动态通道'
            };
        }
        return channelStats[source];
    }

    function markChannelSeen(source, url, reason = '候选 URL') {
        const stat = ensureChannelStats(source);
        stat.seen++;
        stat.lastUrl = String(url || '').slice(0, 240);
        stat.lastReason = reason;
        scheduleUIUpdate();
    }

    function markChannelAccepted(source, url) {
        const stat = ensureChannelStats(source);
        stat.accepted++;
        stat.lastAcceptedUrl = String(url || '').slice(0, 240);
        stat.lastReason = '已命中';
        scheduleUIUpdate();
    }

    function markChannelFiltered(source, reason) {
        const stat = ensureChannelStats(source);
        stat.filtered++;
        stat.lastReason = reason;
        scheduleUIUpdate();
    }

    function escapeHTML(value) {
        return String(value ?? '').replace(/[&<>"']/g, char => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[char]));
    }

    function safeStorageGet(storage, key, fallback = '') {
        try { return storage.getItem(key) || fallback; } catch (e) { return fallback; }
    }

    function safeStorageSet(storage, key, value) {
        try { storage.setItem(key, String(value)); } catch (e) {}
    }

    function setManagedTimeout(fn, delay) {
        const timer = setTimeout(() => { routeTimers.delete(timer); fn(); }, delay);
        routeTimers.add(timer);
        return timer;
    }

    function clearManagedTimers() {
        for (const timer of routeTimers) clearTimeout(timer);
        routeTimers.clear();
    }

    function waitForElement(selector, { retries = 30, interval = 300 } = {}) {
        const selectors = selector.split(',').map(s => s.trim()).filter(Boolean);
        return new Promise(resolve => {
            let attempts = 0;
            const timer = setInterval(() => {
                const el = selectors.map(s => document.querySelector(s)).find(Boolean);
                if (el || attempts >= retries) { clearInterval(timer); resolve(el || null); }
                attempts++;
            }, interval);
        });
    }

    function formatTime(seconds) {
        const total = Math.max(0, Math.floor(Number(seconds) || 0));
        const h = Math.floor(total / 3600);
        const m = Math.floor((total % 3600) / 60);
        const s = total % 60;
        return h > 0
            ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
            : `${m}:${String(s).padStart(2, '0')}`;
    }

    function toAbsoluteUrl(url) {
        if (!url) return '';
        if (url.startsWith('http://') || url.startsWith('https://')) return url;

        let domain = capturedImageDomain;
        if (!domain) {
            if (capturedUrls && capturedUrls.length > 0) {
                try {
                    domain = new URL(capturedUrls[0].url).origin;
                } catch(e) {}
            }
        }

        // 只有在拼装图片 .dat 资源时，才启用硬编码 CDN 域名映射，防止误伤视频播放直链
        if (!domain && (url.includes('/vod/') && url.includes('.dat'))) {
            const host = window.location.hostname;
            if (host.includes('yydnz.com') || host.includes('dyopn95') || host.includes('hatv.im')) {
                domain = 'https://soost.hnxyjws.com';
            }
        }

        // 其它普通资源（如视频播放流 m3u8）使用当前站点域名作为保底
        if (!domain) {
            domain = window.location.origin;
        }

        try { return new URL(url, domain).href; } catch (e) { return ''; }
    }

    function getVideoIdFromUrl(url) {
        let videoId = 'KM_Video';
        const cleanUrl = String(url || '').split('?')[0];
        const segments = cleanUrl.split('/').filter(Boolean);
        const lastSegment = segments[segments.length - 1] || '';
        if (lastSegment && lastSegment.includes('.m3u8') && lastSegment !== 'index.m3u8') {
            videoId = lastSegment.replace('.m3u8', '').replace(PREVIEW_MARK_RE, '');
        } else if (segments.length >= 2) {
            videoId = (segments[segments.length - 2] || '').replace(PREVIEW_MARK_RE, '');
        }
        return videoId || 'KM_Video';
    }

    function aesEncrypt(plaintext) {
        const tmp = CryptoJS.enc.Utf8.parse(plaintext);
        const enc = CryptoJS.AES.encrypt(tmp, KEY, { iv: IV, mode: MODE, padding: PADDING });
        return enc.ciphertext.toString().toUpperCase();
    }

    function aesDecrypt(ciphertext) {
        try {
            const tmp = CryptoJS.enc.Hex.parse(ciphertext);
            const tmp2 = CryptoJS.enc.Base64.stringify(tmp);
            const dec = CryptoJS.AES.decrypt(tmp2, KEY, { iv: IV, mode: MODE, padding: PADDING });
            const text = dec.toString(CryptoJS.enc.Utf8);
            return text ? JSON.parse(text) : null;
        } catch (e) { return null; }
    }

    // 新的 Shift-8 + Base64 解密 (适配最新版网站接口)
    function shiftDecrypt(responseRaw) {
        try {
            let shifted = "";
            for (let i = 0; i < responseRaw.length; i++) {
                let code = responseRaw.charCodeAt(i);
                shifted += String.fromCharCode((code - 8 + 256) % 256);
            }
            const decoded = decodeURIComponent(escape(atob(shifted)));
            return JSON.parse(decoded);
        } catch (e) {
            return null;
        }
    }

    // 智能解密：优先尝试移位解密，其次尝试 AES 解密
    function smartDecrypt(responseRaw) {
        if (!responseRaw) return null;
        const res = shiftDecrypt(responseRaw);
        if (res) return res;
        return aesDecrypt(responseRaw);
    }

    // 移位加密 (配合解密欺骗 Axios/网页前端)
    function shiftEncrypt(jsonObj) {
        try {
            const rawStr = btoa(unescape(encodeURIComponent(JSON.stringify(jsonObj))));
            let shifted = "";
            for (let i = 0; i < rawStr.length; i++) {
                let code = rawStr.charCodeAt(i);
                shifted += String.fromCharCode((code + 8) % 256);
            }
            return shifted;
        } catch (e) {
            return null;
        }
    }

    // 智能解密、篡改并重新加密 API 响应数据
    function modifyAndReEncryptResponse(rawText) {
        if (!rawText) return rawText;

        let decrypted = shiftDecrypt(rawText);
        let isShift = false;
        if (decrypted) {
            isShift = true;
        } else {
            decrypted = aesDecrypt(rawText);
        }

        if (decrypted) {
            let modified = false;

            const processObj = (obj) => {
                if (!obj || typeof obj !== 'object') return;

                if (obj.hasOwnProperty('vodPic') && obj.hasOwnProperty('vodPlayUrl')) {
                    const fullM3u8 = getPlayUrlFromCover(obj.vodPic);
                    if (fullM3u8) {
                        let prefix = "";
                        if (obj.vodPlayUrl.includes('$')) {
                            prefix = obj.vodPlayUrl.split('$')[0] + '$';
                        }
                        const hijackedUrl = prefix + fullM3u8;
                        console.log('[快猫劫持] 自动劫持API响应中的视频，篡改播放直链:', hijackedUrl);
                        obj.vodPlayUrl = hijackedUrl;
                        if (obj.hasOwnProperty('vodPrice')) obj.vodPrice = 0;
                        if (obj.hasOwnProperty('vodCoinPrice')) obj.vodCoinPrice = 0;
                        if (obj.hasOwnProperty('onlyBuy')) obj.onlyBuy = false;
                        modified = true;
                    }
                }

                for (let k in obj) {
                    if (typeof obj[k] === 'object') {
                        processObj(obj[k]);
                    }
                }
            };

            processObj(decrypted);

            if (modified) {
                if (isShift) {
                    const enc = shiftEncrypt(decrypted);
                    if (enc) return enc;
                } else {
                    const enc = aesEncrypt(JSON.stringify(decrypted));
                    if (enc) return enc;
                }
            }
        }
        return rawText;
    }

    function getSignature(data) {
        function serialize(obj) {
            return Object.keys(obj).filter(key => obj[key] !== undefined && obj[key] !== null).sort().map(key => {
                return `${encodeURIComponent(key)}=${encodeURIComponent(obj[key])}`;
            }).join("&");
        }
        const rawStr = serialize(data);
        const salt = rawStr + 'ohI}-bFpD*z8)W7~REusVa]U`YKQ=[C1&XZ."n5:dl<{?@J6NkO+f%c^"$tevxB>j2M_9;G#y3Tw|gL/HS,Pqr0!Ami(49Y_.~Tan#z{5ZLO,_E(7!vJ^HC5_{Xq5$z*';
        return CryptoJS.enc.Hex.stringify(CryptoJS.MD5(salt)).toUpperCase();
    }

    // ========== HTTP 请求 ==========

    function httpRequest(options) {
        return new Promise((resolve, reject) => {
            const hasGM = typeof GM_xmlhttpRequest !== 'undefined';
            if (hasGM) {
                try {
                    GM_xmlhttpRequest({
                        timeout: 15000,
                        ...options,
                        onload: res => {
                            if (res.status >= 200 && res.status < 300) resolve(res.responseText);
                            else reject(new Error(`HTTP ${res.status}: ${res.statusText || ''}`));
                        },
                        onerror: err => reject(err),
                        ontimeout: () => reject(new Error('HTTP timeout'))
                    });
                    return;
                } catch (e) {
                    console.warn('[快猫提取] GM_xmlhttpRequest 调用异常，Fallback to fetch:', e);
                }
            }

            const fetchOpts = {
                method: options.method || 'GET',
                headers: options.headers || {}
            };
            if (options.data) {
                fetchOpts.body = options.data;
            }
            fetch(options.url, fetchOpts)
                .then(res => {
                    if (res.ok) return res.text();
                    throw new Error(`HTTP ${res.status}: ${res.statusText}`);
                })
                .then(resolve)
                .catch(reject);
        });
    }

    async function queryApi(apiPath, data = {}) {
        const payload = { ...data };
        delete payload.signature;
        payload.signature = getSignature(payload);
        const encData = aesEncrypt(JSON.stringify(payload));

        const formData = new URLSearchParams();
        formData.append('data', encData);
        formData.append('device_version', 'pc');
        formData.append('device_type', 'pc');
        formData.append('version_code', '1.0');
        formData.append('device', 'pc');
        formData.append('api_token', "");
        formData.append('c_name', 'developer-default');

        try {
            const rawResponse = await httpRequest({
                url: apiPath,
                data: formData.toString(),
                method: "POST",
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            return smartDecrypt(rawResponse);
        } catch (e) {
            console.error('[快猫提取] API 请求失败:', e);
            const fallbackPath = `${window.location.origin}/api/video/index`;
            if (apiPath !== fallbackPath) {
                console.log('[快猫提取] 动态 API 访问受阻，尝试同源备份请求:', fallbackPath);
                return queryApi(fallbackPath, { ...data, signature: undefined });
            }
            showToast('⚠️ 获取后台数据失败');
            return null;
        }
    }

    // ========== 核心业务逻辑：视频捕获 ==========

    function addCaptured(url, title, source) {
        if (!url || typeof url !== 'string') return;
        url = url.trim();
        if (!url.startsWith('http')) return;
        markChannelAccepted(source, url);

        if (capturedUrlMap.has(url)) {
            const item = capturedUrlMap.get(url);
            if (!item) return;
            if (title && (!item.title || item.title === '未知视频')) item.title = title;
            if (!item.sources.includes(source)) item.sources.push(source);
            item.sourceHits[source] = (item.sourceHits[source] || 0) + 1;
            item.lastHitAt = Date.now();
            console.log(`[快猫提取][${source}] 重复命中已聚合: ${url}`);
            scheduleUIUpdate();
            return;
        }

        const record = {
            url,
            title: title || '未知视频',
            source,
            sources: [source],
            sourceHits: { [source]: 1 },
            timestamp: Date.now(),
            lastHitAt: Date.now()
        };
        capturedUrlMap.set(url, record);
        capturedUrls.push(record);
        console.log(`[快猫提取][${source}] 捕获成功: ${url}`);
        scheduleUIUpdate();
    }

    function processCapturedUrl(url, source) {
        markChannelSeen(source, url);
        if (!url || typeof url !== 'string') {
            markChannelFiltered(source, '空 URL 或非字符串');
            return;
        }
        url = url.trim();
        if (url.startsWith('blob:') || url.startsWith('data:')) {
            markChannelFiltered(source, 'blob/data URL 已过滤');
            return;
        }
        if (/\/api\//.test(url) && !url.includes('.m3u8')) {
            markChannelFiltered(source, 'API 请求已过滤');
            return;
        }
        url = toAbsoluteUrl(url) || url;

        let targetUrl = '';
        if (/\.m3u8(?:[?#]|$)/i.test(url)) {
            targetUrl = url;
        } else if (/\.ts(?:[?#]|$)/i.test(url)) {
            targetUrl = url.replace(/\/[^/?#]+\.ts(?:[?#].*)?$/i, '/index.m3u8');
        }

        if (targetUrl && targetUrl.includes('.m3u8')) {
            // 解密替换核心：将试看 preview 替换为完整版 wm 流
            let fullUrl = targetUrl.replace(/_preview(?:\.mp4)?/g, '_wm.mp4');
            fullUrl = fullUrl.split('?')[0];

            try {
                const urlObj = new URL(url, window.location.origin);
                setCapturedVideoCdn(urlObj.origin + "/");
            } catch(e) {}

            const videoId = getVideoIdFromUrl(targetUrl);

            if (videoId !== 'KM_Video' && videoId !== currentActiveVideoId) {
                currentActiveVideoId = videoId;
                resetCapturedUrls();
                console.log(`[快猫提取] 检测到切换视频为: ${videoId}，已自动清空历史缓存`);
            }

            addCaptured(fullUrl, `视频_${videoId} (已解锁完整版)`, source);
        } else {
            markChannelFiltered(source, '不是 m3u8/ts');
        }
    }

    // ========== 域名与 CDN 管理 ==========

    function getDynamicApiAddr() {
        if (SETTINGS.apiAddr && SETTINGS.apiAddr.startsWith('http')) return SETTINGS.apiAddr;
        if (capturedApiDomain) return `${capturedApiDomain}/api/video/index`;
        return `${WIN.location.origin}/api/video/index`;
    }

    function setCapturedApiDomain(domain) {
        if (!domain || capturedApiDomain === domain) return;
        capturedApiDomain = domain;
        safeStorageSet(localStorage, 'km_captured_api_domain', domain);
        console.log('[快猫提取] 捕获并保存最新 API 域名:', domain);
    }

    function getDynamicM3u8Prefix(coverUrl) {
        if (capturedVideoCdn) return capturedVideoCdn;
        if (coverUrl) {
            try {
                const urlObj = new URL(coverUrl, window.location.origin);
                if (urlObj.host !== window.location.host) return `${urlObj.origin}/`;
            } catch(e) {}
        }
        return SETTINGS.m3u8Prefix || `${window.location.origin}/`;
    }

    // 设置捕获的视频 CDN 域名
    function setCapturedVideoCdn(cdn) {
        if (!cdn || capturedVideoCdn === cdn) return;
        capturedVideoCdn = cdn;
        safeStorageSet(localStorage, 'km_captured_video_cdn', cdn);
        console.log('[快猫提取] 捕获并保存最新 CDN 域名:', cdn);
    }

    function getPlayUrlFromCover(coverUrl) {
        if (!coverUrl) return '';
        const hashMatch = coverUrl.match(VIDEO_HASH_RE);
        if (hashMatch && hashMatch[1]) {
            let hostPrefix = "";
            try {
                const commonInfo = JSON.parse(localStorage.getItem("commonInfo") || "{}");
                if (commonInfo && commonInfo.s3Url) {
                    hostPrefix = commonInfo.s3Url;
                }
            } catch (e) {}
            if (!hostPrefix || !hostPrefix.startsWith('http')) {
                hostPrefix = getDynamicM3u8Prefix(coverUrl);
            }
            if (!hostPrefix.endsWith('/')) {
                hostPrefix += '/';
            }
            const relativePath = coverUrl.replace(/^\//, '').replace('c.dat', 'index.m3u8');
            return `${hostPrefix}${relativePath}`;
        }
        return '';
    }

