    async function renderVideoItems(ulElement, queryData, append = false, isSearch = false) {
        if (!append) {
            renderStatus(ulElement, '正在获取完整解密视频...', '#aaa');
        }

        let response = null;
        if (isSearch) {
            response = await querySearchApi(queryData.keyword, queryData.page);
        } else {
            response = await queryApi(getDynamicApiAddr(), queryData);
        }

        if (!response || !response.data || !response.data.video_list) {
            if (!append) {
                renderStatus(ulElement, '获取视频失败，请点击重试', '#ff3b30');
            }
            return;
        }
        if (!append) {
            ulElement.textContent = '';
        }

        const fragment = document.createDocumentFragment();
        response.data.video_list.forEach((item) => {
            const playUrl = getPlayUrlFromCover(item.cover);
            const li = document.createElement("li");
            li.style.cssText = "width:calc(16.6% - 10px); margin:5px; box-sizing:border-box;";
            const safeCover = toAbsoluteUrl(item.cover || '');
            const card = createVideoCard({
                cover: safeCover, gold: item.gold || 0,
                title: item.title || '未知视频', nickname: item.nickname || '',
                praiseNum: item.praise_num || 0
            });
            li.appendChild(card);
            card.addEventListener("click", () => {
                if (playUrl) playM3u8Inline(playUrl, item.title || '未知视频');
                else showToast("❌ 无法提取视频直链");
            });
            fragment.appendChild(li);
        });
        ulElement.appendChild(fragment);
    }

