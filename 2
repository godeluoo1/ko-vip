    function createUI() {
        if (document.getElementById('km-float-btn')) return;

        floatBtn = document.createElement('div');
        floatBtn.id = 'km-float-btn';
        floatBtn.innerHTML = '🐱';
        floatBtn.addEventListener('click', () => panel.classList.toggle('visible'));
        document.body.appendChild(floatBtn);

        panel = document.createElement('div');
        panel.id = 'km-panel';
        panel.innerHTML = `
            <div id="km-panel-header">
                <h3>快猫视频解析与提取面板</h3>
                <button id="km-panel-close">&times;</button>
            </div>
            <div id="km-panel-body">
                <div class="km-empty">⏳ 暂无视频被捕获，正在监测中...</div>
            </div>
        `;
        document.body.appendChild(panel);

        panel.querySelector('#km-panel-close').addEventListener('click', () => panel.classList.remove('visible'));

        document.addEventListener('click', (e) => {
            if (panel && panel.classList.contains('visible') && !panel.contains(e.target) && !floatBtn.contains(e.target)) {
                panel.classList.remove('visible');
            }
        });

        toastEl = document.createElement('div');
        toastEl.id = 'km-toast';
        document.body.appendChild(toastEl);
    }

    function showToast(msg) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        setTimeout(() => toastEl.classList.remove('show'), 2500);
    }

    function updateUI() {
        if (!floatBtn) return;
        if (capturedUrls.length > 0) {
            floatBtn.classList.add('has-capture');
            floatBtn.innerHTML = `<span style="font-size:15px; font-weight:bold;">${capturedUrls.length}</span>`;
        } else {
            floatBtn.classList.remove('has-capture');
            floatBtn.innerHTML = '🐱';
        }

        if (!panel) return;
        const body = panel.querySelector('#km-panel-body');
        if (capturedUrls.length === 0) {
            body.innerHTML = '<div class="km-empty">⏳ 暂无视频被捕获，正在监测中...</div>';
            return;
        }

        let html = '';
        capturedUrls.forEach((item, index) => {
            html += `
                <div class="km-item">
                    <div class="km-title-line" title="${item.title}">${item.title}</div>
                    <div class="km-action-line">
                        <span class="km-badge">${item.source}</span>
                        <div class="km-btn-group">
                            <button class="km-action-btn km-play-btn" data-index="${index}">▶ 播放</button>
                            <button class="km-action-btn km-copy-btn" data-index="${index}">复制</button>
                        </div>
                    </div>
                </div>
            `;
        });
        body.innerHTML = html;

        // 绑定按钮事件
        body.querySelectorAll(".km-play-btn").forEach(btn => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const item = capturedUrls[btn.dataset.index];
                playM3u8Inline(item.url, item.title);
            });
        });

        body.querySelectorAll(".km-copy-btn").forEach(btn => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const item = capturedUrls[btn.dataset.index];
                try {
                    GM_setClipboard(item.url, 'text');
                    showToast('✅ 复制成功');
                } catch (err) {
                    navigator.clipboard.writeText(item.url)
                        .then(() => showToast('✅ 复制成功'))
                        .catch(() => showToast('❌ 复制失败'));
                }
            });
        });
    }

    // ========== 全通道监控捕获 (XHR + Fetch + Performance + Player) ==========

    function processCapturedUrl(url, source) {
        if (!url || typeof url !== 'string') return;
        url = url.trim();
        if (url.startsWith('blob:') || url.startsWith('data:')) return;
        if (/\/api\//.test(url)) return; // 过滤 API 请求

        let targetUrl = '';
        if (url.includes('.m3u8')) {
            targetUrl = url;
        } else if (url.includes('.ts')) {
            // 从 TS 分片反推 m3u8
            targetUrl = url.replace(/\/[^\/]+\.ts.*/, '/index.m3u8');
        }

        if (targetUrl && targetUrl.includes('.m3u8')) {
            // 将预览版标志自动转换为完整版 (_wm.mp4)
            let fullUrl = targetUrl.replace(/_preview\.mp4/g, '_wm.mp4')
                                   .replace(/_preview/g, '_wm.mp4')
                                   .replace(/_preview/g, '_wm');

            // 剥离所有的查询参数
            fullUrl = fullUrl.split('?')[0];

            // 提取唯一视频ID并动态捕获视频 CDN 域名
            let videoId = 'KM_Video';
            try {
                const urlObj = new URL(url, window.location.origin);
                capturedVideoCdn = urlObj.origin + "/";
            } catch(e) {}

            const cleanUrl = targetUrl.split('?')[0];
            const segments = cleanUrl.split('/');
            const lastSegment = segments[segments.length - 1];
            if (lastSegment && lastSegment.includes('.m3u8') && lastSegment !== 'index.m3u8') {
                videoId = lastSegment.replace('.m3u8', '').replace(/_preview\.mp4|_preview|_wm\.mp4|_wm/, '');
            } else if (segments.length >= 2) {
                const parentSegment = segments[segments.length - 2];
                if (parentSegment) {
                    videoId = parentSegment.replace(/_preview\.mp4|_preview|_wm\.mp4|_wm/, '');
                }
            }

            // 切换视频时清空历史
            if (videoId !== 'KM_Video' && videoId !== currentActiveVideoId) {
                currentActiveVideoId = videoId;
                capturedUrls = [];
                console.log(`[快猫提取] 检测到切换视频为: ${videoId}，已自动清空历史缓存`);
            }

            addCaptured(fullUrl, `视频_${videoId} (已解锁完整版)`, source);
        }
    }

    // 1. XHR Hook
    function installXHRHook() {
        const win = unsafeWindow || window;
        const OriginalXHR = win.XMLHttpRequest;
        if (!OriginalXHR) return;
        function HookedXHR() {
            const xhr = new OriginalXHR();
            let _url = '';
            const origOpen = xhr.open;
            xhr.open = function (method, url, ...args) {
                _url = url;
                // 动态捕获最新 API 域名
                if (url && (url.includes('/api/video/') || url.includes('/api/'))) {
                    try {
                        const urlObj = new URL(url, win.location.origin);
                        capturedApiDomain = urlObj.origin;
                        console.log('[快猫提取] XHR 捕获到最新 API 域名:', capturedApiDomain);
                    } catch(e) {}
                }
                return origOpen.apply(xhr, [method, url, ...args]);
            };
            const origSend = xhr.send;
            xhr.send = function (...args) {
                xhr.addEventListener('load', function () {
                    try {
                        processCapturedUrl(_url, 'XHR Hook');
                    } catch (e) {}
                });
                return origSend.apply(xhr, args);
            };
            return xhr;
        }
        HookedXHR.prototype = OriginalXHR.prototype;
        Object.assign(HookedXHR, OriginalXHR);
        try {
            Object.defineProperty(win, 'XMLHttpRequest', { value: HookedXHR, writable: true, configurable: true });
        } catch(e) { win.XMLHttpRequest = HookedXHR; }
        console.log('[快猫提取] XHR Hook 捕获通道已启动');
    }

    // 2. Fetch Hook
    function installFetchHook() {
        const win = unsafeWindow || window;
        if (typeof win.fetch !== 'function') return;
        const origFetch = win.fetch.bind(win);
        win.fetch = function (input, init) {
            const url = (typeof input === 'string') ? input : (input && input.url) || '';
            // 动态捕获最新 API 域名
            if (url && (url.includes('/api/video/') || url.includes('/api/'))) {
                try {
                    const urlObj = new URL(url, win.location.origin);
                    capturedApiDomain = urlObj.origin;
                    console.log('[快猫提取] Fetch 捕获到最新 API 域名:', capturedApiDomain);
                } catch(e) {}
            }
            processCapturedUrl(url, 'Fetch Hook');
            return origFetch(input, init);
        };
        console.log('[快猫提取] Fetch Hook 捕获通道已启动');
    }

    // 3. Performance API 监控
    function installPerformanceObserver() {
        try {
            const perfObserver = new PerformanceObserver((list) => {
                for (const entry of list.getEntries()) {
                    const name = entry.name || '';
                    if (name.includes('.m3u8') || name.includes('.ts')) {
                        processCapturedUrl(name, 'Performance API');
                    }
                }
            });
            perfObserver.observe({ type: 'resource', buffered: true });
            console.log('[快猫提取] Performance Observer 捕获通道已启动');
        } catch (e) {}
    }

    // 4. 播放器实例劫持
    function installPlayerHijack() {
        const scan = () => {
            const videos = document.querySelectorAll('video');
            for (const video of videos) {
                const hls = video.__hls || video.hls || video._hls;
                if (hls && hls.url) {
                    processCapturedUrl(hls.url, '播放器劫持');
                }
                if (video.src && (video.src.includes('.m3u8') || video.src.includes('.ts'))) {
                    processCapturedUrl(video.src, '播放器劫持');
                }
            }
        };
        setInterval(scan, 2000);
        console.log('[快猫提取] 播放器劫持 捕获通道已启动');
    }

    // ========== 初始化与运行监控 ==========
    function init() {
        if (window.location.pathname.includes('d2b.html')) {
            window.location.replace(window.location.origin + '/pc/index');
            return;
        }
        injectStyles();
        createUI();

        // 启动网络与播放层拦截捕获
        installXHRHook();
        installFetchHook();
        installPerformanceObserver();
        installPlayerHijack();

        // 启动页面路由轮询监控
        let previousUrl = '';
        const routeObserver = new MutationObserver(() => {
            const nowUrl = window.location.href;
            if (nowUrl !== previousUrl) {
                previousUrl = nowUrl;
                handleRouteChanged();
            }
        });
        routeObserver.observe(document, { subtree: true, childList: true });

        handleRouteChanged();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    console.log('[快猫提取] 视频加解密与在线播放器已成功挂载。');
})();
