// ==UserScript==
// @name         快猫视频提取与播放器 (全通道版)
// @namespace    kuaimao-extractor
// @version      1.1.0
// @description  免收费观看快猫VIP付费视频，提取高清完整版m3u8地址，支持网页内嵌播放、链接复制与下载，内置全自动API加解密与签名通道。
// @author       Custom
// @match        *://*/pc/index*
// @match        *://*/*/pc/index*
// @match        *://*/pc/*
// @match        *://*/*/pc/*
// @match        *://*/d2b.html*
// @match        *://*/*/d2b.html*
// @require      https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.0.0/crypto-js.min.js
// @require      https://cdn.jsdelivr.net/npm/hls.js@1.5.8
// @require      https://cdn.jsdelivr.net/npm/dplayer@1.27.1/dist/DPlayer.min.js
// @grant        GM_addStyle
// @grant        GM_setClipboard
// @grant        GM_xmlhttpRequest
// @grant        unsafeWindow
// @connect      *
// @run-at       document-start
// @license      MIT
// ==/UserScript==

(function () {
    'use strict';

    // ========== 全局配置与状态 ==========
    const SETTINGS = {
        apiAddr: "", // 置空以启用全自动动态域名捕获
        m3u8Prefix: "https://oafjdskpqwjnizlqwenmaqwkcxzpty.keyms2r.xyz/", // 静态兜底前缀
        perPage: 18,
        themeColor: "linear-gradient(135deg, #ff9f0a 0%, #ff3b30 100%)",
        themeShadow: "0 4px 15px rgba(255, 159, 10, 0.4)"
    };

    let capturedUrls = []; // { url: string, title: string, source: string, timestamp: number }
    let pageIndex = 1;
    let mediaType = 1;
    let currentHash = '';
    let capturedApiDomain = ''; // 动态捕获的 API 域名
    let capturedVideoCdn = '';   // 动态捕获的视频 CDN 域名
    let currentActiveVideoId = '';

    // 页面类型与媒体ID的映射关系
    const mediaTypes = {
        "0": 11, "原创视频": 11,
        "1": 3, "热门视频": 3,
        "2": 1, "精选视频": 1,
        "3": 9, "付费视频": 9,
        "4": 2, "视频广场": 2
    };

    // ========== AES 加解密 & 签名核心 ==========
    const KEY = CryptoJS.enc.Utf8.parse("x;j/6olSp})&{ZJD");
    const IV = CryptoJS.enc.Utf8.parse("znbV%$JN5olCpt<c");
    const MODE = CryptoJS.mode.CBC;
    const PADDING = CryptoJS.pad.Pkcs7;

    function aesEncrypt(plaintext) {
        let tmp = CryptoJS.enc.Utf8.parse(plaintext);
        let enc = CryptoJS.AES.encrypt(tmp, KEY, { iv: IV, mode: MODE, padding: PADDING });
        return enc.ciphertext.toString().toUpperCase();
    }

    function aesDecrypt(ciphertext) {
        let tmp = CryptoJS.enc.Hex.parse(ciphertext);
        let tmp2 = CryptoJS.enc.Base64.stringify(tmp);
        let dec = CryptoJS.AES.decrypt(tmp2, KEY, { iv: IV, mode: MODE, padding: PADDING });
        return JSON.parse(dec.toString(CryptoJS.enc.Utf8));
    }

    function getSignature(data) {
        function serialize(obj) {
            return Object.keys(obj).sort().map(key => {
                return `${encodeURIComponent(key)}=${encodeURIComponent(obj[key])}`;
            }).join("&");
        }
        let rawStr = serialize(data);
        // 快猫专有的签名盐值
        let salt = rawStr + 'ohI}-bFpD*z8)W7~REusVa]U`YKQ=[C1&XZ."n5:dl<{?@J6NkO+f%c^"$tevxB>j2M_9;G#y3Tw|gL/HS,Pqr0!Ami(49Y_.~Tan#z{5ZLO,_E(7!vJ^HC5_{Xq5$z*';
        return CryptoJS.enc.Hex.stringify(CryptoJS.MD5(salt)).toUpperCase();
    }

    // 封装异步 HTTP 网络通道
    function httpRequest(options) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                ...options,
                onload: res => resolve(res.responseText),
                onerror: err => reject(err)
            });
        });
    }

    // 发起 API 签名密文查询
    async function queryApi(apiPath, data = {}) {
        data.signature = getSignature(data);
        const encData = aesEncrypt(JSON.stringify(data));

        let formData = new URLSearchParams();
        formData.append('data', encData);
        formData.append('device_version', 'pc');
        formData.append('device_type', 'pc');
        formData.append('version_code', '1.0');
        formData.append('device', 'pc');
        formData.append('api_token', "");
        formData.append('c_name', 'developer-default');

        try {
            const rawResponse = await httpRequest({
                url: apiPath,
                data: formData.toString(),
                method: "POST",
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            return aesDecrypt(rawResponse);
        } catch (e) {
            console.error('[快猫提取] API 请求失败:', e);
            // 备份重试：如果当前动态 API 报错，尝试退回到网页同源域名作为备份
            const fallbackPath = `${window.location.origin}/api/video/index`;
            if (apiPath !== fallbackPath) {
                console.log('[快猫提取] 动态 API 访问受阻，尝试同源备份请求:', fallbackPath);
                return queryApi(fallbackPath, data);
            }
            showToast('⚠️ 获取后台数据失败');
            return null;
        }
    }

    // ========== 核心业务逻辑：视频拦截与自动破解 ==========

    function addCaptured(url, title, source) {
        if (!url || typeof url !== 'string') return;
        url = url.trim();
        if (!url.startsWith('http')) return;

        const exists = capturedUrls.some(item => item.url === url);
        if (exists) return;

        capturedUrls.push({ url, title: title || '未知视频', source, timestamp: Date.now() });
        console.log(`[快猫提取][${source}] 捕获成功: ${url}`);
        updateUI();
    }

    // 全自动动态继承 API 域名
    function getDynamicApiAddr() {
        const win = unsafeWindow || window;
        if (capturedApiDomain) {
            return `${capturedApiDomain}/api/video/index`;
        }
        if (SETTINGS.apiAddr && SETTINGS.apiAddr.startsWith('http')) {
            return SETTINGS.apiAddr;
        }
        return `${win.location.origin}/api/video/index`;
    }

    // 动态提取与计算 m3u8 播放前缀
    function getDynamicM3u8Prefix(coverUrl) {
        if (capturedVideoCdn) {
            return capturedVideoCdn;
        }
        if (coverUrl) {
            try {
                const urlObj = new URL(coverUrl, window.location.origin);
                // 如果图片在专门的 CDN 域名上，优先继承该 CDN 作为视频源前缀
                if (urlObj.host !== window.location.host) {
                    return `${urlObj.origin}/`;
                }
            } catch(e) {}
        }
        return SETTINGS.m3u8Prefix || `${window.location.origin}/`;
    }

    // 解析封面图片链接，反推完整版 m3u8 点播链
    function getPlayUrlFromCover(coverUrl) {
        if (!coverUrl) return '';
        const match = coverUrl.match(/\/uploads\/cover\/(.*?)\./);
        if (match && match[1]) {
            const hostPrefix = getDynamicM3u8Prefix(coverUrl);
            return `${hostPrefix}uploads/video/${match[1]}_wm.mp4/index.m3u8`;
        }
        return '';
    }

    // ========== 页面流劫持与 DOM 注入 ==========

    async function handleRouteChanged() {
        const hash = window.location.hash;
        if (hash === currentHash) return;
        currentHash = hash;

        // 切换页面时重置捕获数据
        capturedUrls = [];
        updateUI();

        if (hash === "#/" || hash === "") {
            showToast('💡 进入首页，正在剔除广告并加载破解通道...');
            setTimeout(executeIndexBypass, 1000);
        } else if (hash.includes("#/video_list?type=")) {
            const typeMatch = hash.match(/type=(\d+)/);
            if (typeMatch) {
                mediaType = mediaTypes[typeMatch[1]] || 1;
                showToast('💡 进入列表页，启动视频拦截...');
                setTimeout(() => executeListBypass(0), 300);
            }
        } else if (hash.includes("#/user_details?id=")) {
            const idMatch = hash.match(/id=(\d+)/);
            if (idMatch) {
                mediaType = 5;
                showToast('💡 进入博主主页，启动视频提取...');
                setTimeout(() => executeListBypass(idMatch[1]), 300);
            }
        }
    }

    // 列表页拦截重构
    async function executeListBypass(userId = 0) {
        let queryData = {};
        let box = null;

        if (userId === 0) {
            queryData = { type: mediaType, page: pageIndex, perPage: SETTINGS.perPage };
            // 清理原生不可用的切换菜单
            const titleEl = document.querySelector("#app > div.videolist > div.title");
            if (titleEl) titleEl.remove();
            box = document.querySelector("#app > div.videolist > div.box");
        } else {
            queryData = { type: mediaType, page: pageIndex, by_id: userId };
            box = document.querySelector("#app > div.details");
        }

        if (!box) return;

        // 构建脚本专属的控制和翻页层
        box.innerHTML = '';
        const wrapper = document.createElement("div");
        wrapper.className = "km-wrapper";
        box.appendChild(wrapper);

        const listContainer = document.createElement("ul");
        listContainer.style.cssText = "display:flex; flex-wrap:wrap; width:100%; list-style:none; padding:0; margin:0;";
        wrapper.appendChild(listContainer);

        // 分页翻页栏
        const pagination = document.createElement("div");
        pagination.className = "km-pagination";
        pagination.style.cssText = "display:flex; justify-content:center; gap:20px; width:100%; margin-top:20px;";
        wrapper.appendChild(pagination);

        const btnPrev = document.createElement("button");
        btnPrev.innerText = "上一页";
        btnPrev.className = "km-page-btn";
        btnPrev.addEventListener("click", async () => {
            if (pageIndex <= 1) return;
            pageIndex--;
            queryData.page = pageIndex;
            delete queryData.signature;
            await renderVideoItems(listContainer, queryData);
        });
        pagination.appendChild(btnPrev);

        const btnNext = document.createElement("button");
        btnNext.innerText = "下一页";
        btnNext.className = "km-page-btn";
        btnNext.addEventListener("click", async () => {
            pageIndex++;
            queryData.page = pageIndex;
            delete queryData.signature;
            await renderVideoItems(listContainer, queryData);
        });
        pagination.appendChild(btnNext);

        await renderVideoItems(listContainer, queryData);
    }

    // 首页广告切除与劫持
    async function executeIndexBypass() {
        // 清理首页硬广告组件
        document.querySelectorAll(".banner_vue, .rightside").forEach(el => el.remove());

        document.querySelectorAll("div.hotarea").forEach(async (hotarea) => {
            const titleEl = hotarea.previousElementSibling?.querySelector("div.title > div.name > p:nth-child(1)");
            if (titleEl && titleEl.textContent in mediaTypes) {
                const listUl = hotarea.querySelector("ul");
                if (listUl) {
                    let queryData = { type: mediaTypes[titleEl.textContent], page: 1, perPage: 7 };
                    await renderVideoItems(listUl, queryData);
                }
                // 剔除换一批按钮防止破坏劫持结构
                const refreshBtn = hotarea.previousElementSibling?.querySelector("div.title > p");
                if (refreshBtn) refreshBtn.remove();
            }
        });
    }

    // 渲染解密视频条目
    async function renderVideoItems(ulElement, queryData) {
        ulElement.innerHTML = '<div style="color:#aaa; text-align:center; width:100%; padding:30px;">正在获取完整解密视频...</div>';

        const response = await queryApi(getDynamicApiAddr(), queryData);
        if (!response || !response.data || !response.data.video_list) {
            ulElement.innerHTML = '<div style="color:#ff3b30; text-align:center; width:100%; padding:30px;">获取视频失败，请点击重试</div>';
            return;
        }

        ulElement.innerHTML = '';
        response.data.video_list.forEach((item) => {
            const playUrl = getPlayUrlFromCover(item.cover);
            if (playUrl) {
                addCaptured(playUrl, item.title, "API自动解密");
            }

            let li = document.createElement("li");
            li.style.cssText = "width:calc(16.6% - 10px); margin:5px; box-sizing:border-box;";
            li.innerHTML = `
                <div class="km-card" style="background:#222; border-radius:8px; overflow:hidden; border:1px solid #333; position:relative; cursor:pointer;">
                    <div class="km-badge-gold" style="position:absolute; top:5px; left:5px; background:linear-gradient(90deg,#ff9f0a,#ff3b30); color:#fff; font-size:11px; padding:2px 6px; border-radius:4px; z-index:5;">${item.gold} 金币</div>
                    <div style="width:100%; height:130px; background-size:cover; background-position:center; background-image:url('${item.cover}');"></div>
                    <div style="padding:8px;">
                        <p style="margin:0; font-size:12px; color:#fff; height:32px; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">${item.title}</p>
                        <div style="display:flex; justify-content:space-between; margin-top:5px; font-size:11px; color:#aaa;">
                            <span>👤 ${item.nickname}</span>
                            <span>👍 ${item.praise_num}</span>
                        </div>
                    </div>
                </div>
            `;

            // 点击卡片直接唤起内嵌播放器播放
            li.querySelector(".km-card").addEventListener("click", () => {
                if (playUrl) {
                    playM3u8Inline(playUrl, item.title);
                } else {
                    showToast("❌ 无法提取视频直链");
                }
            });
            ulElement.appendChild(li);
        });
    }

    // ========== 内置 DPlayer 浮动播放器 ==========
    let activePlayer = null;

    function playM3u8Inline(url, title) {
        // 先销毁已有播放器
        destroyPlayer();

        const overlay = document.createElement("div");
        overlay.id = "km-player-overlay";
        overlay.style.cssText = `
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.85); display: flex; align-items: center;
            justify-content: center; z-index: 999999; backdrop-filter: blur(10px);
        `;

        const playerContainer = document.createElement("div");
        playerContainer.style.cssText = `
            width: 800px; max-width: 90%; background: #111; border-radius: 12px;
            border: 1px solid #333; overflow: hidden; box-shadow: 0 25px 50px rgba(0,0,0,0.8);
            position: relative;
        `;

        const header = document.createElement("div");
        header.style.cssText = `
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 20px; border-bottom: 1px solid #222; background: #161616;
        `;
        header.innerHTML = `
            <span style="color:#fff; font-size:14px; font-weight:bold; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:80%;">${title}</span>
            <button id="km-player-close" style="background:rgba(255,255,255,0.1); border:none; color:#aaa; font-size:20px; width:30px; height:30px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center;">&times;</button>
        `;
        playerContainer.appendChild(header);

        const videoDiv = document.createElement("div");
        videoDiv.id = "km-dplayer";
        videoDiv.style.height = "450px";
        playerContainer.appendChild(videoDiv);

        overlay.appendChild(playerContainer);
        document.body.appendChild(overlay);

        // 初始化 DPlayer + hls.js
        activePlayer = new DPlayer({
            container: videoDiv,
            autoplay: true,
            theme: '#ff9f0a',
            loop: false,
            lang: 'zh-cn',
            screenshot: true,
            hotkey: true,
            video: {
                url: url,
                type: 'customHls',
                customType: {
                    customHls: function (videoEl) {
                        const hlsInstance = new Hls({ maxBufferSize: 100000000 });
                        hlsInstance.loadSource(url);
                        hlsInstance.attachMedia(videoEl);
                    }
                }
            }
        });

        // 移步移动端长按加速
        const playerVideo = videoDiv.querySelector('video');
        if (playerVideo) {
            let longPressTimer = null;
            let wasSpeed = 1;
            let isLongPressing = false;
            let hasMoved = false;
            let touchStartX = 0;
            let touchStartY = 0;

            const showSpeedHint = (msg) => {
                let hint = overlay.querySelector('.km-speed-hint');
                if (!hint) {
                    hint = document.createElement('div');
                    hint.className = 'km-speed-hint';
                    hint.style.cssText = `
                        position: absolute; top: 25%; left: 50%; transform: translate(-50%, -50%);
                        background: rgba(0,0,0,0.75); color: #ff9f0a; padding: 8px 18px; border-radius: 20px;
                        font-size: 13px; z-index: 999999; pointer-events: none; font-weight: bold;
                        border: 1px solid rgba(255, 159, 10, 0.4); box-shadow: 0 4px 10px rgba(0,0,0,0.5);
                    `;
                    overlay.appendChild(hint);
                }
                hint.innerText = msg;
                hint.style.display = 'block';
            };

            const hideSpeedHint = () => {
                const hint = overlay.querySelector('.km-speed-hint');
                if (hint) hint.style.display = 'none';
            };

            playerVideo.addEventListener('touchstart', (e) => {
                if (e.touches.length !== 1) return;
                const touch = e.touches[0];
                touchStartX = touch.clientX;
                touchStartY = touch.clientY;
                hasMoved = false;
                isLongPressing = false;

                longPressTimer = setTimeout(() => {
                    if (hasMoved) return;
                    isLongPressing = true;
                    wasSpeed = playerVideo.playbackRate;
                    playerVideo.playbackRate = 2.0;
                    showSpeedHint('▶▶ 2.0x 长按加速中');
                }, 500);
            }, { passive: true });

            playerVideo.addEventListener('touchmove', (e) => {
                if (e.touches.length !== 1) return;
                const touch = e.touches[0];
                const dx = touch.clientX - touchStartX;
                const dy = touch.clientY - touchStartY;
                if (!hasMoved && (Math.abs(dx) > 12 || Math.abs(dy) > 12)) {
                    hasMoved = true;
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }
                }
            }, { passive: true });

            const endTouch = () => {
                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }
                if (isLongPressing) {
                    playerVideo.playbackRate = wasSpeed;
                    hideSpeedHint();
                    isLongPressing = false;
                }
                hasMoved = false;
            };

            playerVideo.addEventListener('touchend', endTouch, { passive: true });
            playerVideo.addEventListener('touchcancel', endTouch, { passive: true });
        }

        // 绑定关闭事件
        header.querySelector("#km-player-close").addEventListener("click", destroyPlayer);
        overlay.addEventListener("click", (e) => {
            if (e.target === overlay) destroyPlayer();
        });
    }

    function destroyPlayer() {
        if (activePlayer) {
            try { activePlayer.destroy(); } catch (e) {}
            activePlayer = null;
        }
        const overlay = document.getElementById("km-player-overlay");
        if (overlay) overlay.remove();
    }

