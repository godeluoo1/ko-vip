    function createChannelStatsBlock() {
        const box = document.createElement('div');
        box.className = 'km-channel-stats';
        const title = document.createElement('div');
        title.className = 'km-channel-stats-title';
        title.textContent = '通道统计：seen=触发次数，hit=命中次数，filtered=过滤次数';
        box.appendChild(title);
        const names = Object.keys(channelStats);
        names.forEach(name => {
            const stat = channelStats[name];
            const row = document.createElement('div');
            row.className = 'km-channel-stat-row';
            row.title = stat.lastAcceptedUrl || stat.lastUrl || stat.lastReason || '';
            const left = document.createElement('span');
            left.className = 'km-channel-stat-name';
            left.textContent = name;
            const right = document.createElement('span');
            right.className = stat.accepted > 0 ? 'km-channel-stat-ok' : 'km-channel-stat-zero';
            right.textContent = `seen ${stat.seen} / hit ${stat.accepted} / filtered ${stat.filtered} / ${stat.lastReason}`;
            row.append(left, right);
            box.appendChild(row);
        });
        return box;
    }

    // ========== 捕获通道 1 & 2: Performance API & Polling ==========

    function installPerformanceObserver() {
        try {
            const perfObserver = new PerformanceObserver((list) => {
                for (const entry of list.getEntries()) {
                    const name = entry.name || '';
                    if (name.includes('.m3u8') || name.includes('.ts')) {
                        processCapturedUrl(name, 'Performance API');
                    }
                }
            });
            perfObserver.observe({ type: 'resource', buffered: true });
            console.log('[快猫提取] Performance Observer 捕获通道已启动');
        } catch (e) {
            markChannelFiltered('Performance API', `启动失败: ${e.message || e}`);
        }
    }

    let performancePollingTimer = null;
    const performanceSeenEntries = new Set();

    // 轮询 Performance 性能面板数据
    function installPerformancePolling() {
        const scan = () => {
            try {
                const entries = performance.getEntriesByType('resource') || [];
                for (const entry of entries) {
                    const name = entry.name || '';
                    if (!name || performanceSeenEntries.has(name)) continue;
                    performanceSeenEntries.add(name);
                    if (name.includes('.m3u8') || name.includes('.ts')) {
                        processCapturedUrl(name, 'Performance Polling');
                    }
                }
                if (typeof performance.clearResourceTimings === 'function') {
                    performance.clearResourceTimings();
                }
            } catch (e) {
                markChannelFiltered('Performance Polling', `扫描失败: ${e.message || e}`);
            }
        };
        if (performancePollingTimer) clearInterval(performancePollingTimer);
        scan();
        performancePollingTimer = setInterval(scan, 1500);
        console.log('[快猫提取] Performance Polling 兜底通道已启动');
    }

    // ========== 捕获通道 3 & 4: Video Tag & Source Tag Hook ==========

    let lastUserActionTime = 0;
    window.addEventListener('click', () => { lastUserActionTime = Date.now(); }, true);
    window.addEventListener('keydown', () => { lastUserActionTime = Date.now(); }, true);
    window.addEventListener('touchstart', () => { lastUserActionTime = Date.now(); }, true);

    function startWatchdog(video) {
        if (!video || video._watchdogStarted) return;
        video._watchdogStarted = true;

