    async function querySearchApi(keyword, page) {
        const apiDomain = capturedApiDomain || window.location.origin;
        const url = `${apiDomain}/api/film-b/search`;
        const payload = {
            currentPage: page,
            words: keyword
        };
        try {
            const rawResponse = await httpRequest({
                url: url,
                data: JSON.stringify(payload),
                method: "POST",
                headers: {
                    'Content-Type': 'application/json',
                    'token': (function() {
                        try {
                            return (typeof unsafeWindow !== 'undefined' && unsafeWindow.localStorage)
                                ? unsafeWindow.localStorage.getItem('token')
                                : localStorage.getItem('token');
                        } catch(e) {
                            return '';
                        }
                    })() || ''
                }
            });
            const dec = smartDecrypt(rawResponse);
            // 将搜索 API 结构转换为已有列表 API 结构以进行零成本复用
            if (dec && dec.data) {
                dec.data.forEach(item => {
                    item.title = item.vodName || '未知视频';
                    item.cover = item.vodPic || '';
                    item.gold = item.vodPointsPlay || 0;
                    item.nickname = item.vodClass || '搜索结果';
                    item.praise_num = 0;
                });
                return {
                    data: {
                        video_list: dec.data
                    }
                };
            }
            return null;
        } catch (e) {
            console.error('[快猫提取] 搜索 API 请求失败:', e);
            return null;
        }
    }

