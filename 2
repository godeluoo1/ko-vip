                        targetSource = source.replace(/_preview(?:\.mp4)?/g, '_wm.mp4').split('?')[0];
                        console.log('[快猫页劫持] 自动替换 Hls.js 试看流 -> 完整版:', targetSource);
                    }
                    if (source && typeof WIN.processCapturedUrl === 'function') {
                        WIN.processCapturedUrl(source, 'Hls.js Hook (Page)');
                    }
                    originalLoadSource.call(this, targetSource);
                };
            };

            if (typeof WIN.Hls !== 'undefined') {
                hookHlsPrototype(WIN.Hls);
            }

            let hlsVal = WIN.Hls;
            Object.defineProperty(WIN, 'Hls', {
                get: function() { return hlsVal; },
                set: function(newVal) {
                    hlsVal = newVal;
                    if (newVal) {
                        hookHlsPrototype(newVal);
                    }
                },
                configurable: true
            });
            console.log('[快猫页劫持] Hls.js 拦截已部署');
        } catch (e) {
            console.error('[快猫页劫持] Hls.js Hook 挂载失败:', e);
        }

        // 4. Hook Fetch
        try {
            if (WIN.fetch) {
                const originalFetch = WIN.fetch;
                WIN.fetch = async function(...args) {
                    const response = await originalFetch.apply(this, args);
                    const contentType = response.headers.get('content-type') || '';
                    const url = response.url;

                    if (url.includes('/api/') && (contentType.includes('text/plain') || contentType.includes('text/html'))) {
                        try {
                            const rawText = await response.text();
                            const modifiedText = WIN.modifyAndReEncryptResponse(rawText);
                            const modifiedResponse = new Response(modifiedText, {
                                status: response.status,
                                statusText: response.statusText,
                                headers: response.headers
                            });
                            Object.defineProperty(modifiedResponse, 'url', { value: response.url });

                            const decrypted = WIN.smartDecrypt(rawText);
                            if (decrypted && decrypted.data && decrypted.data.vodPlayUrl && typeof WIN.processCapturedUrl === 'function') {
                                WIN.processCapturedUrl(decrypted.data.vodPlayUrl, 'Fetch Hook (Page API)');
                            }
                            return modifiedResponse;
                        } catch (e) {
                            console.error('[快猫页劫持] Fetch 响应篡改失败:', e);
                        }
                    }

                    const clone = response.clone();
                    try {
                        if (url.includes('.m3u8') || url.includes('.ts')) {
                            if (typeof WIN.processCapturedUrl === 'function') {
                                WIN.processCapturedUrl(url, 'Fetch Hook (Page)');
                            }
                        } else {
                            const text = await clone.text();
                            if (text.includes('.m3u8')) {
                                const match = text.match(/"([^"]+\.m3u8[^"]*)"/);
                                if (match && typeof WIN.processCapturedUrl === 'function') {
                                    WIN.processCapturedUrl(match[1], 'Fetch Hook (Page)');
                                }
                            }
                        }
                    } catch (e) {}
                    return response;
                };
                console.log('[快猫页劫持] Fetch 劫持就绪');
            }
        } catch (e) {}

        // 5. Hook XMLHttpRequest
        try {
            const originalOpen = WIN.XMLHttpRequest.prototype.open;
            WIN.XMLHttpRequest.prototype.open = function(method, url, ...args) {
                this._url = url;
                return originalOpen.apply(this, [method, url, ...args]);
            };

            const originalSend = WIN.XMLHttpRequest.prototype.send;
            WIN.XMLHttpRequest.prototype.send = function(...args) {
                const self = this;
                self.addEventListener('readystatechange', () => {
                    if (self.readyState === 4) {
                        try {
                            const url = self._url || self.responseURL || '';
                            const contentType = self.getResponseHeader('content-type') || '';

                            if (url.includes('/api/') && (contentType.includes('text/plain') || contentType.includes('text/html'))) {
                                const rawResponseText = self.responseText;
                                if (rawResponseText) {
                                    const hackedResponseText = WIN.modifyAndReEncryptResponse(rawResponseText);
                                    Object.defineProperty(self, 'responseText', {
                                        get: function() { return hackedResponseText; },
                                        configurable: true
                                    });
                                    Object.defineProperty(self, 'response', {
                                        get: function() { return hackedResponseText; },
                                        configurable: true
                                    });
                                    const decrypted = WIN.smartDecrypt(rawResponseText);
                                    if (decrypted && decrypted.data && decrypted.data.vodPlayUrl && typeof WIN.processCapturedUrl === 'function') {
                                        WIN.processCapturedUrl(decrypted.data.vodPlayUrl, 'XHR Hook (Page API)');
                                    }
                                }
                            }
                            if (url && (url.includes('.m3u8') || url.includes('.ts'))) {
                                if (typeof WIN.processCapturedUrl === 'function') {
                                    WIN.processCapturedUrl(url, 'XHR Hook (Page)');
                                }
                            } else if (self.responseText && self.responseText.includes('.m3u8')) {
                                const match = self.responseText.match(/"([^"]+\.m3u8[^"]*)"/);
                                if (match && typeof WIN.processCapturedUrl === 'function') {
                                    WIN.processCapturedUrl(match[1], 'XHR Hook (Page)');
                                }
                            }
                        } catch (e) {}
                    }
                });
                return originalSend.apply(this, args);
            };
            console.log('[快猫页劫持] XHR 劫持就绪');
        } catch (e) {}
    }

    function init() {
        if (window.location.pathname.includes('d2b.html')) {
            window.location.replace(window.location.origin + '/pc/index');
            return;
        }
        injectStyles();
        createUI();
        hookHistoryAPI();

        if (!hooksInstalled) {
            hooksInstalled = true;
            installPerformanceObserver();
            installPerformancePolling();
            installVideoTagHook();
            installHlsHook();
        }

        let previousUrl = window.location.href;
        if (routeMutationObserver) routeMutationObserver.disconnect();
        routeMutationObserver = new MutationObserver(() => {
            const nowUrl = window.location.href;
            if (nowUrl !== previousUrl) {
                previousUrl = nowUrl;
                clearTimeout(routeDebounceTimer);
                routeDebounceTimer = setManagedTimeout(handleRouteChanged, 80);
            }
        });
        routeMutationObserver.observe(document.body || document.documentElement || document, { subtree: true, childList: true });

        handleRouteChanged();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    console.log('[快猫提取] 全通道超级视频提取与播放器已挂载（3.0 全通道版）。');
})();
