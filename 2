        try {
            if (window.location.pathname.includes('/movieSearch') || window.location.hash.includes('Search')) {
                await renderVideoItems(listContainer, { keyword: currentKeyword, page: pageIndex }, true, true);
            } else if (window.location.hash.includes("#/video_list?type=") || window.location.pathname.includes("/pc/paginate")) {
